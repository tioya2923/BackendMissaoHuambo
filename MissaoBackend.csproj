<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Ficheiros de importação opcionais para o CanticoPtSeeder (ver Seeds/CanticoPtSeeder.cs).
       Nunca fazem parte do repositório (dados de origem só locais) — a condição evita que a
       compilação falhe quando não existem, como acontece em qualquer checkout novo ou no Render. -->
  <ItemGroup Condition="Exists('..\entrada.txt') Or Exists('..\kyrie.txt') Or Exists('..\gloria.txt') Or Exists('..\intro.txt') Or Exists('..\aleluia.txt') Or Exists('..\ofert.txt')">
    <Content Include="..\entrada.txt" Link="entrada.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\entrada.txt')" />
    <Content Include="..\kyrie.txt" Link="kyrie.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\kyrie.txt')" />
    <Content Include="..\gloria.txt" Link="gloria.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\gloria.txt')" />
    <Content Include="..\intro.txt" Link="intro.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\intro.txt')" />
    <Content Include="..\aleluia.txt" Link="aleluia.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\aleluia.txt')" />
    <Content Include="..\ofert.txt" Link="ofert.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\ofert.txt')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.15.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />

    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />

    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.0" />
  </ItemGroup>

</Project>
